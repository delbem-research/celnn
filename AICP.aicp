@aicp v=semver:0.3.0 id=libpycelnn kind=python-library summary="celnn: Cellular Neural Network (CelNN) simulation library with templates, optional CuPy GPU backend, and DEAP-based genetic-algorithm template training"
@stack lang=set[enum]:[python] runtime=set[enum]:[cpython>=3.10] infra=set[enum]:[conda,pip] package=list[path]:[pyproject.toml,environment.yml] lock=list[path]:[]
@agent read=list[atom]:[@aicp,@stack,@mod,@surface,@resolver,@inv,@task] verify=bool:true update_on_arch_change=bool:true max_context_ratio=float:0.05 mode=guided
@avoid paths=list[glob]:[**/__pycache__/**,dist/**,build/**,.pytest_cache/**,htmlcov/**]
@cmd test "pytest"
@cmd lint "ruff check ."
@mod core kind=core owns=set[id]:[network,simulation,templates,solvers,dynamics,boundary,validation] entry=list[path]:[src/celnn/core/network.py,src/celnn/core/simulation.py,src/celnn/core/templates.py] risk=set[enum]:[numerical-stability] test=list[path]:[tests/] evidence=list[path]:[src/celnn/core/]
@mod backends kind=infra owns=set[id]:[numpy-backend,cupy-backend] entry=list[path]:[src/celnn/backends/numpy_backend.py,src/celnn/backends/cupy_backend.py,src/celnn/backends/protocol.py] risk=set[enum]:[optional-dependency,gpu-environment] evidence=list[path]:[src/celnn/backends/]
@mod training kind=lib owns=set[id]:[ga-trainer,fitness,dataset] entry=list[path]:[src/celnn/training/ga.py,src/celnn/training/fitness.py,src/celnn/training/dataset.py] risk=set[enum]:[optional-dependency] test=list[path]:[tests/test_ga_training.py] evidence=list[path]:[src/celnn/training/,examples/genetic_algorithm_training.py]
@mod templates kind=lib owns=set[id]:[template-registry,builtin-templates] entry=list[path]:[src/celnn/templates/registry.py] evidence=list[path]:[src/celnn/templates/]
@mod domains kind=lib owns=set[id]:[grid,image,signal] entry=list[path]:[src/celnn/domains/] evidence=list[path]:[src/celnn/domains/]
@mod docs kind=docs owns=set[id]:[technical-docs,examples-docs] entry=list[path]:[docs/libcelnn.md,docs/examples.md] evidence=list[path]:[docs/]
@surface ga-trainer owner=mod.training kind=class visibility=public name="celnn.training.GATrainer" evidence=list[path]:[src/celnn/training/ga.py]
@surface ga-config owner=mod.training kind=dataclass visibility=public name="celnn.training.GAConfig" evidence=list[path]:[src/celnn/training/ga.py]
@surface training-dataset owner=mod.training kind=dataclass visibility=public name="celnn.training.TrainingDataset" evidence=list[path]:[src/celnn/training/dataset.py]
@resolver edit-training target=mod.training intent=edit go=list[path]:[src/celnn/training/ga.py,src/celnn/training/fitness.py,src/celnn/training/dataset.py,tests/test_ga_training.py] use=list[enum]:[search,tests] verify=list[string]:["pytest tests/test_ga_training.py"]
@inv ga-minimization scope=set[id]:[mod.training] rule="GA fitness is minimized (DEAP FitnessMin weights=(-1.0,)); lower fitness is better" evidence=list[path]:[src/celnn/training/ga.py]
@inv ga-optional-dep scope=set[id]:[mod.training] rule="DEAP is an optional dependency (extra 'ga'); imports must stay lazy via _try_import_deap" evidence=list[path]:[src/celnn/training/ga.py,pyproject.toml]
@inv fitness-guard scope=set[id]:[mod.training] rule="evaluate_template returns max_loss=1e12 for failed/non-finite simulations to keep the GA stable" evidence=list[path]:[src/celnn/training/fitness.py]
@inv ga-determinism scope=set[id]:[mod.training] rule="GATrainer.run() must seed the global random module when seed is set: DEAP operators (selTournament, cxTwoPoint) draw from it; same seed => identical results" evidence=list[path]:[src/celnn/training/ga.py,tests/test_ga_training.py]
@task ga-presentation status=done touch=list[path]:[slides/] note="PPTX presentation with real experiment figures (slides/run_ga_experiments.py generates assets; slides/build_ga_slides.py builds the deck)"
@policy require-tests scope=global severity=high rule="changed modules must run matching tests" enforce=list[id]:[ci]
@risk stale-context level=medium scope=set[id]:[global] mitigation="update AICP when architecture, contracts, surfaces, invariants, dependencies, risks, tasks, or resolvers change"
@mod arrays kind=core owns=set[id]:[namespace-dispatch] entry=list[path]:[src/celnn/core/arrays.py] risk=set[enum]:[silent-graph-severing] test=list[path]:[tests/test_arrays.py] evidence=list[path]:[src/celnn/core/arrays.py]
@mod stencil kind=infra owns=set[id]:[shared-aggregation] entry=list[path]:[src/celnn/backends/stencil.py] risk=set[enum]:[boundary-semantics] test=list[path]:[tests/test_stencil_backend.py] evidence=list[path]:[src/celnn/backends/stencil.py]
@mod torch-backend kind=infra owns=set[id]:[differentiable-aggregation] entry=list[path]:[src/celnn/backends/torch_backend.py] risk=set[enum]:[optional-dependency] test=list[path]:[tests/test_torch_backend.py,tests/test_dynamics_torch.py] evidence=list[path]:[src/celnn/backends/torch_backend.py]
@mod torch-network kind=lib owns=set[id]:[differentiable-network] entry=list[path]:[future:src/celnn/torch/network.py] risk=set[enum]:[not-implemented] test=list[path]:[tests/test_torch_network.py] evidence=list[path]:[tests/test_torch_network.py]
@surface array-namespace owner=mod.arrays kind=function visibility=public name="celnn.core.arrays.array_namespace" evidence=list[path]:[src/celnn/core/arrays.py]
@surface stencil-backend owner=mod.stencil kind=class visibility=public name="celnn.backends.StencilBackend" evidence=list[path]:[src/celnn/backends/stencil.py]
@surface torch-backend-class owner=mod.torch-backend kind=class visibility=public name="celnn.backends.TorchBackend" evidence=list[path]:[src/celnn/backends/torch_backend.py]
@surface steppers owner=mod.core kind=module visibility=public name="celnn.core.steppers" evidence=list[path]:[src/celnn/core/steppers.py]
@resolver edit-torch target=mod.torch-backend intent=edit go=list[path]:[src/celnn/backends/torch_backend.py,src/celnn/backends/stencil.py,tests/test_torch_backend.py,tests/test_dynamics_torch.py] use=list[enum]:[search,tests] verify=list[string]:["pytest tests/ -k torch"]
@resolver implement-torch-network target=mod.torch-network intent=create go=list[path]:[tests/test_torch_network.py,src/celnn/core/dynamics.py,src/celnn/core/steppers.py,src/celnn/backends/torch_backend.py,future:src/celnn/torch/__init__.py,future:src/celnn/torch/network.py] use=list[enum]:[search,tests] verify=list[string]:["pytest tests/test_torch_network.py"]
@inv single-ode-definition scope=set[id]:[global] rule="celnn.core.dynamics is the ONLY definition of dx/dt = -x + A*y(x) + B*u + z in the library. NumPy, CuPy and torch all evaluate it through the ArrayBackend protocol; it must never be restated per backend. tests/test_dynamics_torch.py proves the reference module runs unmodified on tensors, and git diff against the pre-branch tree must stay empty for that file" evidence=list[path]:[src/celnn/core/dynamics.py,tests/test_dynamics_torch.py]
@inv single-stencil-definition scope=set[id]:[mod.stencil] rule="Template application (pad, then accumulate weighted shifted windows) lives once in StencilBackend. Backends supply only _prepare, _pad, _zeros_like and optionally _fast_path and _finalize; they must not reimplement the loop or keep private copies of the boundary tables in core.boundary" evidence=list[path]:[src/celnn/backends/stencil.py,src/celnn/backends/numpy_backend.py,src/celnn/backends/cupy_backend.py]
@inv single-stepper-definition scope=set[id]:[global] rule="Time integration formulas live once in core.steppers and are pure arithmetic, so they accept numpy arrays, cupy arrays and torch tensors with gradients intact. core.solvers and the differentiable network both call them rather than inlining the update" evidence=list[path]:[src/celnn/core/steppers.py,src/celnn/core/solvers.py]
@inv activations-are-library-agnostic scope=set[id]:[global] rule="Each activation is written once and evaluated by the namespace owning its input. Never call numpy.asarray on a possibly-foreign array inside an activation: it raises for grad-tracking tensors and silently severs the graph where it succeeds. Use core.arrays.as_float_array, which coerces NumPy-shaped input and passes tensors through" evidence=list[path]:[src/celnn/core/activations.py,src/celnn/core/arrays.py]
@inv boundary-parity-by-construction scope=set[id]:[mod.torch-backend] rule="The torch backend derives its gather indices by padding numpy.arange with numpy.pad itself, so boundary semantics agree with the reference backend by construction rather than by reading two libraries' docs. This matters because numpy and scipy already invert the meanings of 'reflect' and 'mirror' (see core.boundary.scipy_mode)" evidence=list[path]:[src/celnn/backends/torch_backend.py,tests/test_torch_backend.py]
@inv torch-diagonal-only scope=set[id]:[mod.torch-backend,mod.torch-network] rule="A (span, channels) template is diagonal: one weight vector per offset, so each channel evolves under its own scalar CelNN and channels never mix inside the dynamics. This is deliberate, and the single-channel case must reduce exactly to the classical NumPy contract. Cross-channel computation belongs to an explicit mixing term supplied by the caller, not to this backend" evidence=list[path]:[src/celnn/backends/torch_backend.py,tests/test_torch_backend.py]
@inv torch-optional-dep scope=set[id]:[mod.torch-backend,mod.torch-network] rule="PyTorch is an optional dependency; 'import celnn' must work without it. celnn.backends exposes TorchBackend through a module __getattr__, and tests guard with pytest.importorskip. Mirrors the existing ga-optional-dep invariant for DEAP" evidence=list[path]:[src/celnn/backends/__init__.py,tests/test_torch_backend.py]
@task differentiable-backend status=in-progress touch=list[path]:[src/celnn/core/arrays.py,src/celnn/core/activations.py,src/celnn/core/steppers.py,src/celnn/backends/stencil.py,src/celnn/backends/numpy_backend.py,src/celnn/backends/cupy_backend.py,src/celnn/backends/torch_backend.py,tests/] note="Branch feat/differentiable-backend, 7 commits. DONE: array namespace dispatch; library-agnostic activations; shared StencilBackend with numpy and cupy migrated onto it; TorchBackend; shared core.steppers with core.solvers rewired; proof that core.dynamics runs unmodified on tensors. NEXT: implement src/celnn/torch/ to satisfy the already-written RED spec in tests/test_torch_network.py, then docs/torch-backend.md, the torch extra in pyproject.toml, README and CI. Test env: PYTHONPATH=src with /home/tomieiro/miniconda3/envs/llm-cuda/bin/python (no pycelnn env exists)"
@risk deap-tests-do-not-skip level=low scope=set[id]:[mod.training] mitigation="tests/test_ga_training.py fails rather than skipping when DEAP is absent, unlike the CuPy tests. Pre-existing, unrelated to the differentiable work; baseline is 5 such failures. Add pytest.importorskip('deap') to make the suite honest"
@note reuse-result note="The differentiable path reuses rather than restates: core/dynamics.py is byte-for-byte unchanged (git diff main is empty for it) and now serves NumPy, CuPy and PyTorch through the pre-existing ArrayBackend protocol. The seam was already in the codebase; only the activations blocked it, by coercing through numpy.asarray"
